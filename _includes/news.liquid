<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% assign current_year = null %}
        {% for item in news limit: news_limit %}
          {% comment %} On the full list, a divider and heading for each year, as on the alumni list {% endcomment %}
          {% assign item_year = item.date | date: '%Y' %}
          {% if include.limit != true and item_year != current_year %}
            <tr class="news-year">
              <th colspan="2" scope="rowgroup">{{ item_year }}</th>
            </tr>
            {% assign current_year = item_year %}
          {% endif %}
          <tr>
            <th
              scope="row"
              {% if include.limit %}
                style="width: 20%"
              {% else %}
                class="news-date"
              {% endif %}
            >
              {%- if include.limit -%}
                {{ item.date | date: '%b %d, %Y' }}
              {%- else -%}
                {{ item.date | date: '%b %d' }}
              {%- endif -%}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        <div class="col-12 text-center">
          <a href="/news/">See full list of announcements here</a>
        </div>
      {% endif %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
