<!-- _includes/alumni.liquid: compact list entry for one finished lab role (person + role) -->
<li class="alumni-item">
  <div class="alumni-photo">
    {%- if person.img %}
      {%-
        include figure.liquid
        loading="lazy"
        path=person.img
        alt=person.firstname
        class="rounded-circle"
        width="40"
        sizes="40px"
      -%}
    {%- endif %}
  </div>
  <div class="alumni-main">
    <span class="alumni-name">
      {%- if person.redirect -%}
        <a href="{{ person.redirect }}">
          {{- person.firstname }}
          {{ person.lastname -}}
        </a>
      {%- else -%}
        {{ person.firstname }}
        {{ person.lastname }}
      {%- endif -%}
    </span>
    {%- if person.pronouns %}
      <span class="alumni-pronouns">({{ person.pronouns }})</span>
    {%- endif %}
    <div class="alumni-role">
      {{ role.description }}
      {%- if role.affiliation %}
        <span class="alumni-affiliation">{{ role.affiliation }}</span>
      {%- endif %}
      {%- if role.start_year %}
        <span class="alumni-dates">{% include people_dates.liquid %}</span>
      {%- endif %}
    </div>
    {%- comment -%} Someone still in the lab is "now" in their current role {%- endcomment -%}
    {%- assign current_role = person.roles | where_exp: 'r', 'r.end_year == nil' | first -%}
    {%- if current_role %}
      <div class="alumni-now"><span class="alumni-now-label">Now</span> {{ current_role.description }}, Calgary ML Lab</div>
    {%- elsif person.current_position %}
      <div class="alumni-now"><span class="alumni-now-label">Now</span> {{ person.current_position | escape }}</div>
    {%- endif %}
  </div>
  <div class="alumni-icons">
    {% include people_icons.liquid %}
  </div>
</li>
