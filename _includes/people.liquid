<!-- _includes/persons.html -->
<div class="grid-item">
  <div class="card hoverable">
    {% if person.redirect -%}
      <a href="{{ person.redirect }}">
    {%- else -%}
      <a href="{{ person.url | relative_url }}">
    {%- endif %}
      {%- if person.img %}
        {%- include figure.liquid
          loading="eager"
          path=person.img
          alt="Portrait"
          class="img-fluid rounded-circle z-depth-0"
          sizes="(min-width: 576px) 200px, 45vw"
        -%}
      {%- endif %}
      <h2 class="card-title text-capitalize">
        {{ person.firstname }} {{ person.lastname }}
      </h2>
      {%- if person.pronouns -%}
        <h3 class="card-title card-pronouns mb-2">
          {{ person.pronouns }}
        </h3>
      {%- endif -%}
    </a>
    <div class="card-icons">
      {% include people_icons.liquid %}
      </div>
      <div class="card-body">
        <h3 class="card-text mt-1">{{ role.description }}</h3>
        {%- if role.start_year %}
          <p class="card-dates">{% include people_dates.liquid %}</p>
        {%- endif %}
      </div>
    </div>
</div>